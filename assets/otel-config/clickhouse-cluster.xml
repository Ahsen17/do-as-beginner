<?xml version="1.0"?>
<clickhouse>
    <!-- ZooKeeper is the coordination service for `ON CLUSTER` DDL and
         (optionally) Replicated tables. Mirrors the official SigNoz standalone setup. -->
    <zookeeper>
        <node index="1">
            <host>zookeeper</host>
            <port>2181</port>
        </node>
    </zookeeper>

    <!-- Single-node cluster for SigNoz distributed tables.
         SigNoz's schema-migrator issues DDL with `ON CLUSTER ${SIGNOZ_CLUSTER}`,
         so a cluster named "cluster" must exist even on a standalone setup. -->
    <remote_servers>
        <cluster>
            <shard>
                <replica>
                    <host>clickhouse</host>
                    <port>9000</port>
                </replica>
            </shard>
        </cluster>
    </remote_servers>
</clickhouse>
